# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

min_ios_version_supported = '16.0'
platform :ios, min_ios_version_supported
prepare_react_native_project!

ENV['RCT_NEW_ARCH_ENABLED'] = '0'

use_frameworks!

target 'AudienzzrnExample' do
  # Pin AudienzziOSSDK to the exact release tag so CocoaPods fetches it
  # directly from GitHub. Remove this override once 0.3.0 is on the CocoaPods trunk.
  pod 'AudienzziOSSDK', :git => 'https://github.com/audienzz/audienzz-ios-sdk.git', :tag => '0.3.0'
  # AudienzziOSSDK 0.3.0 builds against STOCK PrebidMobile (no fork) — its analytics
  # use the fork-free economics path. Pin 3.3.1+ for the UserUniqueID(uniqueId:) API;
  # GMAS 13 raises the min iOS deployment target to 15.
  pod 'PrebidMobile',                 '~> 3.3.1'
  pod 'PrebidMobileGAMEventHandlers', '~> 3.3.1'
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end