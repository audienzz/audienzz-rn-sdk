# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

min_ios_version_supported = '16.0'
platform :ios, min_ios_version_supported
prepare_react_native_project!

ENV['RCT_NEW_ARCH_ENABLED'] = '0'

use_frameworks!

target 'AudienzzrnExample' do
  # Published native SDK by default. For local development only, set
  # AUDIENZZ_IOS_SDK_PATH to the native checkout before pod install.
  # See LOCAL_TESTING.md; never commit a lockfile containing that local path.
  audienzz_local_ios_sdk = ENV['AUDIENZZ_IOS_SDK_PATH']
  if audienzz_local_ios_sdk && !audienzz_local_ios_sdk.empty?
    Pod::UI.puts "[Audienzz] using LOCAL iOS SDK at #{audienzz_local_ios_sdk}".yellow
    pod 'AudienzziOSSDK', :path => audienzz_local_ios_sdk
  else
    pod 'AudienzziOSSDK', '~> 0.4.0'
  end
  # AudienzziOSSDK 0.4.0 builds against STOCK PrebidMobile (no fork) — its analytics
  # use the fork-free economics path. Pin 3.3.1+ for the UserUniqueID(uniqueId:) API;
  # GMAS 13 raises the min iOS deployment target to 15.
  pod 'PrebidMobile',                 '~> 3.3.1'
  pod 'PrebidMobileGAMEventHandlers', '~> 3.3.1'
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'AudienzzrnExampleTests' do
    inherit! :search_paths
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
